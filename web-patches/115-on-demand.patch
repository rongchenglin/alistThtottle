--- /dev/null
+++ b/scripts/paging.test.mjs
@@ -0,0 +1,105 @@
+import { strict as assert } from "node:assert"
+import { test } from "node:test"
+import ts from "typescript"
+import { readFileSync } from "node:fs"
+const source = readFileSync(
+  new URL("../src/utils/paging.ts", import.meta.url),
+  "utf8",
+)
+const compiled = ts.transpileModule(source, {
+  compilerOptions: { module: ts.ModuleKind.ESNext },
+}).outputText
+const { boundedPageSize, listPageState, pagingMode, sortRequest, canLoadMore } =
+  await import(
+    `data:text/javascript;base64,${Buffer.from(compiled).toString("base64")}`
+  )
+
+test("all/auto become manual only for source pagination", () => {
+  for (const mode of ["all", "auto_load_more", "load_more", "pagination"]) {
+    assert.equal(pagingMode(true, mode), "pagination")
+    assert.equal(pagingMode(false, mode), mode)
+  }
+  assert.equal(boundedPageSize(-1), 50)
+  assert.equal(boundedPageSize(1000), 500)
+  assert.equal(boundedPageSize(100), 100)
+})
+test("server-clamped page size and page are authoritative", () => {
+  const state = listPageState(
+    { page: 2, per_page: 50, total: 500, has_more: true },
+    8,
+    -1,
+  )
+  assert.equal(state.page, 2)
+  assert.equal(state.perPage, 50)
+  assert.equal(state.hasMore, true)
+})
+test("empty filtered pages retain next; raw total is not exact", () => {
+  const state = listPageState(
+    {
+      page: 3,
+      per_page: 50,
+      filtered_total: 1000,
+      total_exact: false,
+      has_more: true,
+      content: [],
+    },
+    3,
+    50,
+  )
+  assert.equal(state.hasMore, true)
+  assert.equal(state.totalExact, false)
+  assert.equal(
+    listPageState({ has_more: false, total: 1000 }, 3, 50).hasMore,
+    false,
+  )
+})
+test("sort parameters use upstream names and direction; no source prefetch", () => {
+  assert.deepEqual(sortRequest({ orderBy: "modified", reverse: true }), {
+    order_by: "modified",
+    order_direction: "desc",
+  })
+  assert.deepEqual(sortRequest({ orderBy: "size", reverse: false }), {
+    order_by: "size",
+    order_direction: "asc",
+  })
+  assert.deepEqual(sortRequest(), {})
+  assert.equal(canLoadMore(true, true, true), false)
+  assert.equal(canLoadMore(false, true, true), true)
+  assert.equal(canLoadMore(false, false, true), false)
+})
+test("integration guards: sort only on user action, reset history, keep source order", () => {
+  const read = (path) =>
+    readFileSync(new URL(`../src/${path}`, import.meta.url), "utf8")
+  const list = read("pages/home/folder/List.tsx")
+  assert.match(
+    list,
+    /setSortPreference\(orderBy\(\)!, reverse\(\), getCurrentPath\(\)\)/,
+  )
+  assert.match(
+    list,
+    /setSearchParams\(\{ page: 1, per_page: objStore.perPage \}\)/,
+  )
+  assert.match(list, /void refresh\(false, false\)/)
+  assert.match(read("store/obj.ts"), /if \(objStore.sourcePagination\) return/)
+  assert.match(
+    read("hooks/usePath.ts"),
+    /!sourcePagination\[path\] && hasHistory/,
+  )
+  assert.match(
+    read("store/history.ts"),
+    /if \(objStore.sourcePagination\) return/,
+  )
+})
+
+// Source checks stay lightweight and are intended for CI, not a production build.
+test("deep links request their explicit range without probing page one", () => {
+  const hook = readFileSync(new URL("../src/hooks/usePath.ts",import.meta.url),"utf8")
+  assert.match(hook,/const requestPage = index && index > 0 \? index : 1/)
+  assert.doesNotMatch(hook,/const explicit =/)
+})
+test("history restores continuation and actual appended page", () => {
+  const hook = readFileSync(new URL("../src/hooks/usePath.ts",import.meta.url),"utf8")
+  const history = readFileSync(new URL("../src/store/history.ts",import.meta.url),"utf8")
+  assert.match(hook,/globalHasMore = objStore.hasMore/)
+  assert.match(history,/page: objStore.page \|\| getGlobalPage\(\)/)
+})
