diff --git a/src/utils/paging.ts b/src/utils/paging.ts
new file mode 100644
index 0000000..a82e15a
--- /dev/null
+++ b/src/utils/paging.ts
@@ -0,0 +1,50 @@
+// Source pagination is always explicit, even when the site requests all/auto.
+export const pagingMode = (source: boolean, configured: string) =>
+  source ? "pagination" : configured
+
+export const boundedPageSize = (size?: number) =>
+  Number.isFinite(size) && size! > 0
+    ? Math.min(500, Math.max(1, Math.floor(size!)))
+    : 50
+
+export const listPageState = (
+  data: {
+    page?: number
+    per_page?: number
+    has_more?: boolean
+    total?: number
+    filtered_total?: number
+    total_exact?: boolean
+  },
+  page: number,
+  perPage: number,
+) => {
+  const actualPage = data.page && data.page > 0 ? data.page : page
+  const actualSize =
+    data.per_page && data.per_page > 0 ? data.per_page : perPage
+  const total = data.filtered_total ?? data.total ?? 0
+  return {
+    page: actualPage,
+    perPage: actualSize,
+    // Never infer the end from visible content: filtering can empty a page.
+    hasMore: data.has_more ?? actualPage * actualSize < total,
+    total,
+    totalExact: data.total_exact !== false,
+  }
+}
+
+export const sortRequest = (preference?: {
+  orderBy: "name" | "size" | "modified"
+  reverse: boolean
+}) =>
+  preference
+    ? {
+        order_by: preference.orderBy,
+        order_direction: preference.reverse
+          ? ("desc" as const)
+          : ("asc" as const),
+      }
+    : {}
+
+export const canLoadMore = (source: boolean, known: boolean, more: boolean) =>
+  !source && known && more
